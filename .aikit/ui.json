{
  "schema": 1,
  "surfaces": {
    "cli": {
      "paths": [
        "demo.py",
        "inventory.py"
      ]
    },
    "board": {
      "paths": [
        "start.py",
        "ui_server.py"
      ]
    }
  },
  "protected": [
    "tests/**"
  ],
  "commands": {
    "fast": "python demo.py --scripted --seed 1",
    "snapshot": "python inventory.py"
  },
  "style": {
    "theme_paths": []
  },
  "limits": {
    "max_files": 12,
    "max_lines": 300
  }
}
